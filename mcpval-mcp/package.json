{
  "name": "mcpval-localmcp",
  "version": "1.1.33",
  "description": "Local MCP server that wraps the mcpval CLI — validate MCP servers from any AI agent",
  "author": "Rakesh Navale",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "mcpval-localmcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/cli-runner.test.ts tests/handlers.test.ts tests/server-surface.test.ts tests/strict-stdio-server-transport.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "npm run typecheck",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcpval",
    "mcpval-localmcp",
    "validation",
    "compliance",
    "security",
    "ai-safety"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/navalerakesh/mcp-validation-security"
  },
  "homepage": "https://github.com/navalerakesh/mcp-validation-security#readme",
  "bugs": {
    "url": "https://github.com/navalerakesh/mcp-validation-security/issues"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "fast-check": "^4.7.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
