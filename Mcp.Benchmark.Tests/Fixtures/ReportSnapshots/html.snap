          <div class="ledger-group">
            <h3 class="minor-title">Security Vulnerabilities</h3>
            <div class="ledger-list">
              <article class="ledger-entry ledger-entry--danger">
                <div class="ledger-rail">
                  <div class="ledger-kicker">Issue</div>
                  <div class="ledger-code"><code>MCP.SECURITY.PROMPT_INJECTION</code></div>
                  <div class="ledger-chip-row"><span class="tone-chip tone-info">heuristic</span> <span class="tone-chip tone-danger">Critical</span></div>
                  <div class="ledger-subtle">prompt:get</div>
                </div>
                <div class="ledger-body">
                  <div class="ledger-title">Prompt injection reflection</div>
                  <p class="ledger-copy">Server reflected untrusted prompt content without sanitization.</p>
                  <p class="ledger-copy"><strong>Remediation:</strong> Sanitize and label untrusted content before returning it.</p>
                </div>
              </article>
          </div>
          </div>

        </div></details></section>

