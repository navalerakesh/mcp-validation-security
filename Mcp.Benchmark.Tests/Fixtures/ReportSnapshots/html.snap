                  <div class="ledger-chip-row"><span class="tone-chip tone-info">heuristic</span> <span class="tone-chip tone-danger">Critical</span></div>
                  <div class="ledger-subtle">prompt:get</div>
                </div>
                <div class="ledger-body">
