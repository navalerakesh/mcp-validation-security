{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/navalerakesh/mcp-validation-security/blob/main/docs/Schemas/mcpval-validation-result.schema.json",
  "title": "MCP Validator Canonical Assurance Result",
  "type": "object",
  "required": [
    "documentType",
    "documentSchemaVersion",
    "producer",
    "run",
    "measurements",
    "evidence",
    "compatibility",
    "assurance"
  ],
  "properties": {
    "documentType": { "const": "mcpval.assurance-result" },
    "documentSchemaVersion": { "const": "2.0.0" },
    "producer": {
      "type": "object",
      "required": ["name", "packageId", "repositoryUrl", "packageUrl"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "packageId": { "type": "string", "minLength": 1 },
        "repositoryUrl": { "type": "string", "format": "uri" },
        "packageUrl": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": ["validationId"],
      "properties": {
        "validationId": { "type": "string", "minLength": 1 },
        "protocolVersion": { "type": ["string", "null"] },
        "schemaVersion": { "type": ["string", "null"] },
        "targetIdentitySha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "executionPlanSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "executionMode": { "enum": ["safe", "standard", "elevated"] },
        "plannedChecks": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "operationalMetrics": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["runCorrelationId", "validatorOverheadMs", "totalRunDurationMs", "requestBudgetLimit", "requestsStarted", "requestsCompleted", "requestsFailed", "retryCount", "retryDelayMs", "truncatedResponseCount", "targetLatencyP50Ms", "targetLatencyP95Ms", "targetLatencyP99Ms", "queueTimeP95Ms", "targetLatencySampleCount", "queueTimeSampleCount", "throughputRequestsPerSecond", "errorRate", "evidenceCoverageRatio", "stageDurationMs"],
              "properties": {
                "runCorrelationId": { "type": "string", "minLength": 1 },
                "validatorOverheadMs": { "type": "number", "minimum": 0 },
                "totalRunDurationMs": { "type": "number", "minimum": 0 },
                "requestBudgetLimit": { "type": "integer", "minimum": 0 },
                "requestsStarted": { "type": "integer", "minimum": 0 },
                "requestsCompleted": { "type": "integer", "minimum": 0 },
                "requestsFailed": { "type": "integer", "minimum": 0 },
                "retryCount": { "type": "integer", "minimum": 0 },
                "retryDelayMs": { "type": "number", "minimum": 0 },
                "truncatedResponseCount": { "type": "integer", "minimum": 0 },
                "targetLatencyP50Ms": { "type": "number", "minimum": 0 },
                "targetLatencyP95Ms": { "type": "number", "minimum": 0 },
                "targetLatencyP99Ms": { "type": "number", "minimum": 0 },
                "queueTimeP95Ms": { "type": "number", "minimum": 0 },
                "targetLatencySampleCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
                "queueTimeSampleCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
                "throughputRequestsPerSecond": { "type": "number", "minimum": 0 },
                "errorRate": { "type": "number", "minimum": 0, "maximum": 1 },
                "evidenceCoverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
                "stageDurationMs": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
              },
              "additionalProperties": false
            }
          ]
        },
        "modernDiscovery": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/modernDiscoveryTransportResult" }
          ]
        }
      },
      "additionalProperties": true
    },
    "measurements": {
      "type": "object",
      "properties": {
        "protocolCompliance": { "type": ["object", "null"] },
        "toolValidation": { "type": ["object", "null"] },
        "resourceTesting": { "type": ["object", "null"] },
        "promptTesting": { "type": ["object", "null"] },
        "securityTesting": { "type": ["object", "null"] },
        "performanceTesting": { "type": ["object", "null"] },
        "errorHandling": { "type": ["object", "null"] },
        "officialConformance": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/officialConformanceAssessment" }] },
        "extensions": { "type": "array", "items": { "$ref": "#/$defs/extensionAssessment" } },
        "layers": { "type": "array", "items": { "type": "object" } },
        "scenarios": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["coverage", "observations", "appliedPacks"],
      "properties": {
        "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
        "appliedPacks": { "type": "array", "items": { "$ref": "#/$defs/appliedPack" } }
      },
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "clientCompatibility": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/clientCompatibility" }] }
      },
      "additionalProperties": true
    },
    "assurance": { "$ref": "#/$defs/assuranceEvaluation" },
    "policyDecision": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/policyOutcome" }] },
    "baselineComparison": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/baselineComparison" }] }
  },
  "$defs": {
    "assuranceEvaluation": {
      "type": "object",
      "required": ["contractVersion", "profile", "claims", "assessments", "evidenceSummary", "certificateEligibility"],
      "properties": {
        "contractVersion": { "const": "2.0.0" },
        "profile": { "$ref": "#/$defs/assuranceProfile" },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/assuranceClaim" } },
        "assessments": { "$ref": "#/$defs/assuranceAssessments" },
        "evidenceSummary": { "$ref": "#/$defs/evidenceSummary" },
        "certificateEligibility": { "$ref": "#/$defs/certificateEligibility" }
      },
      "additionalProperties": false
    },
    "assuranceProfile": {
      "type": "object",
      "required": ["profileId", "revision", "minimumExecutionMode", "minimumEvidenceCoverageRatio", "minimumEvidenceConfidenceRatio", "minimumRepeatedRunConsistency", "requiresOfficialConformance", "requiresSignedAttestation", "requiresRepeatedRuns", "certificateEligible"],
      "properties": {
        "profileId": { "enum": ["inventory", "ci", "provider"] },
        "revision": { "type": "string", "minLength": 1 },
        "minimumExecutionMode": { "enum": ["safe", "standard", "elevated"] },
        "minimumEvidenceCoverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimumEvidenceConfidenceRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimumRepeatedRunConsistency": { "type": "number", "minimum": 0, "maximum": 1 },
        "requiresOfficialConformance": { "type": "boolean" },
        "requiresSignedAttestation": { "type": "boolean" },
        "requiresRepeatedRuns": { "type": "boolean" },
        "certificateEligible": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "assuranceClaim": {
      "type": "object",
      "required": ["claimId", "subject", "dimension", "requirementLevel", "authority", "source", "applicability", "outcome", "confidence", "evidenceIds", "summary", "metadata"],
      "properties": {
        "claimId": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "dimension": { "enum": ["coreProtocol", "capabilityContract", "security", "operations", "extension", "clientCompatibility", "externalConformance", "executionIntegrity"] },
        "requirementLevel": { "enum": ["must", "should", "may", "securityControl", "operationalObjective", "policy"] },
        "authority": { "enum": ["officialSpecification", "officialConformance", "deterministicSecurity", "operationalMeasurement", "providerPolicy", "heuristic", "modelAdvisory"] },
        "source": { "$ref": "#/$defs/assuranceSource" },
        "applicability": { "enum": ["applicable", "notApplicable"] },
        "applicabilityReason": { "type": ["string", "null"] },
        "outcome": { "enum": ["satisfied", "violated", "incomplete", "reviewRequired", "notApplicable", "error"] },
        "confidence": { "enum": ["none", "low", "medium", "high"] },
        "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "summary": { "type": "string", "minLength": 1 },
        "remediation": { "type": ["string", "null"] },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "assuranceSource": {
      "type": "object",
      "required": ["revision"],
      "properties": {
        "uri": { "type": ["string", "null"] },
        "revision": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^(null|[a-f0-9]{64})$" }
      },
      "additionalProperties": false
    },
    "assuranceAssessments": {
      "type": "object",
      "required": ["coreConformance", "securityAssurance", "operationalReadiness", "extensionReadiness", "clientCompatibility", "externalConformance"],
      "properties": {
        "coreConformance": { "$ref": "#/$defs/coreConformanceAssessment" },
        "securityAssurance": { "$ref": "#/$defs/securityAssuranceAssessment" },
        "operationalReadiness": { "$ref": "#/$defs/operationalReadinessAssessment" },
        "extensionReadiness": { "type": "array", "items": { "$ref": "#/$defs/extensionAssuranceAssessment" } },
        "clientCompatibility": { "type": "array", "items": { "$ref": "#/$defs/clientCompatibilityAssuranceAssessment" } },
        "externalConformance": { "$ref": "#/$defs/externalConformanceAssuranceAssessment" }
      },
      "additionalProperties": false
    },
    "coreConformanceAssessment": {
      "type": "object",
      "required": ["status", "requiredClaims", "satisfiedRequiredClaims", "blockingClaimIds", "incompleteClaimIds"],
      "properties": {
        "status": { "enum": ["conformant", "nonconformant", "incomplete"] },
        "requiredClaims": { "type": "integer", "minimum": 0 },
        "satisfiedRequiredClaims": { "type": "integer", "minimum": 0 },
        "blockingClaimIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "incompleteClaimIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "securityAssuranceAssessment": {
      "type": "object",
      "required": ["status", "deterministicControlClaims", "reviewClaimCount", "issueClaimIds", "incompleteClaimIds"],
      "properties": {
        "status": { "enum": ["verified", "issuesFound", "incomplete"] },
        "deterministicControlClaims": { "type": "integer", "minimum": 0 },
        "reviewClaimCount": { "type": "integer", "minimum": 0 },
        "issueClaimIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "incompleteClaimIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "operationalReadinessAssessment": {
      "type": "object",
      "required": ["status", "objectiveClaims", "failedClaimIds", "incompleteClaimIds"],
      "properties": {
        "status": { "enum": ["ready", "notReady", "incomplete"] },
        "objectiveClaims": { "type": "integer", "minimum": 0 },
        "failedClaimIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "incompleteClaimIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "extensionAssuranceAssessment": {
      "type": "object",
      "required": ["extensionId", "stage", "specificationRevision", "specificationSha256", "status", "nonSuccessClaimIds"],
      "properties": {
        "extensionId": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["experimental", "beta", "stable", "core"] },
        "specificationRevision": { "type": "string", "minLength": 1 },
        "specificationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": { "enum": ["ready", "issuesFound", "incomplete"] },
        "nonSuccessClaimIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "clientCompatibilityAssuranceAssessment": {
      "type": "object",
      "required": ["profileId", "revision", "status", "verification", "summary"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "status": { "enum": ["compatible", "compatibleWithWarnings", "incompatible"] },
        "verification": { "enum": ["interpreted", "verified"] },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "externalConformanceAssuranceAssessment": {
      "type": "object",
      "required": ["status", "creditedPassed", "failed", "skipped", "conflictCount"],
      "properties": {
        "status": { "enum": ["notProvided", "verified", "nonconformant", "incomplete", "conflict"] },
        "requirementSetRevision": { "type": ["string", "null"] },
        "requirementSetSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "creditedPassed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "conflictCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "certificateEligibility": {
      "type": "object",
      "required": ["status", "profileId", "reasons", "evidenceCoverageRatio", "evidenceConfidenceRatio"],
      "properties": {
        "status": { "enum": ["eligible", "ineligible", "reviewRequired"] },
        "profileId": { "enum": ["inventory", "ci", "provider"] },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidenceCoverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceConfidenceRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "verdict": { "enum": ["unknown", "reject", "reviewRequired", "conditionallyAcceptable", "trusted"] },
    "policyOutcome": {
      "type": "object",
      "required": ["mode", "passed", "recommendedExitCode", "summary", "totalSignalCount", "unsuppressedSignalCount", "blockingSignalCount", "reasons", "suppressedSignalCount", "appliedSuppressions", "ignoredSuppressions"],
      "properties": {
        "regressionOnly": { "type": "boolean" },
        "mode": { "enum": ["advisory", "balanced", "strict"] },
        "passed": { "type": "boolean" },
        "recommendedExitCode": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string" },
        "totalSignalCount": { "type": "integer", "minimum": 0 },
        "unsuppressedSignalCount": { "type": "integer", "minimum": 0 },
        "blockingSignalCount": { "type": "integer", "minimum": 0 },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "suppressedSignalCount": { "type": "integer", "minimum": 0 },
        "appliedSuppressions": { "type": "array", "items": { "$ref": "#/$defs/appliedSuppression" } },
        "ignoredSuppressions": { "type": "array", "items": { "type": "object", "required": ["id", "reason"] } }
      },
      "additionalProperties": true
    },
    "appliedSuppression": {
      "type": "object",
      "required": ["id", "owner", "reason", "matchedSignalCount", "matchedSignals"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "expiresOn": { "type": ["string", "null"], "format": "date-time" },
        "matchedSignalCount": { "type": "integer", "minimum": 0 },
        "matchedSignals": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "baselineComparison": {
      "type": "object",
      "required": ["baselineValidationId", "baselineDocumentSchemaVersion", "profileId", "profileRevision", "coreConformanceBefore", "coreConformanceAfter", "securityAssuranceBefore", "securityAssuranceAfter", "operationalReadinessBefore", "operationalReadinessAfter", "certificateEligibilityBefore", "certificateEligibilityAfter", "evidenceCoverageDelta", "evidenceConfidenceDelta", "isRegression", "newNonSuccessClaims", "resolvedNonSuccessClaimIds"],
      "properties": {
        "baselineValidationId": { "type": "string", "minLength": 1 },
        "baselineDocumentSchemaVersion": { "type": "string", "pattern": "^2\\.[0-9]+\\.[0-9]+$" },
        "profileId": { "enum": ["inventory", "ci", "provider"] },
        "profileRevision": { "type": "string", "minLength": 1 },
        "coreConformanceBefore": { "enum": ["conformant", "nonconformant", "incomplete"] },
        "coreConformanceAfter": { "enum": ["conformant", "nonconformant", "incomplete"] },
        "securityAssuranceBefore": { "enum": ["verified", "issuesFound", "incomplete"] },
        "securityAssuranceAfter": { "enum": ["verified", "issuesFound", "incomplete"] },
        "operationalReadinessBefore": { "enum": ["ready", "notReady", "incomplete"] },
        "operationalReadinessAfter": { "enum": ["ready", "notReady", "incomplete"] },
        "certificateEligibilityBefore": { "enum": ["eligible", "ineligible", "reviewRequired"] },
        "certificateEligibilityAfter": { "enum": ["eligible", "ineligible", "reviewRequired"] },
        "evidenceCoverageDelta": { "type": "number", "minimum": -1, "maximum": 1 },
        "evidenceConfidenceDelta": { "type": "number", "minimum": -1, "maximum": 1 },
        "isRegression": { "type": "boolean" },
        "newNonSuccessClaims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claimId", "dimension", "authority", "outcome", "subject"],
            "properties": {
              "claimId": { "type": "string", "minLength": 1 },
              "dimension": { "enum": ["coreProtocol", "capabilityContract", "security", "operations", "extension", "clientCompatibility", "externalConformance", "executionIntegrity"] },
              "authority": { "enum": ["officialSpecification", "officialConformance", "deterministicSecurity", "operationalMeasurement", "providerPolicy", "heuristic", "modelAdvisory"] },
              "outcome": { "enum": ["satisfied", "violated", "incomplete", "reviewRequired", "notApplicable", "error"] },
              "subject": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "resolvedNonSuccessClaimIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "clientCompatibility": {
      "type": "object",
      "required": ["requestedProfiles", "assessments", "compatibleCount", "warningCount", "incompatibleCount"],
      "properties": {
        "requestedProfiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "assessments": { "type": "array", "items": { "type": "object", "required": ["profileId", "displayName", "status"] } },
        "compatibleCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "incompatibleCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "evidenceSummary": {
      "type": "object",
      "required": ["totalDeclarations", "applicableDeclarations", "covered", "authRequired", "inconclusive", "skipped", "notApplicable", "unavailable", "blocked", "evidenceCoverageRatio", "evidenceConfidenceRatio", "confidenceLevel", "categories"],
      "properties": {
        "totalDeclarations": { "type": "integer", "minimum": 0 },
        "applicableDeclarations": { "type": "integer", "minimum": 0 },
        "covered": { "type": "integer", "minimum": 0 },
        "authRequired": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "notApplicable": { "type": "integer", "minimum": 0 },
        "unavailable": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "evidenceCoverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceConfidenceRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidenceLevel": { "enum": ["none", "low", "medium", "high"] },
        "categories": { "type": "array", "items": { "type": "object", "required": ["layerId", "evidenceCoverageRatio", "evidenceConfidenceRatio"] } }
      },
      "additionalProperties": true
    },
    "transportMetadata": {
      "type": "object",
      "required": ["statusCode", "headers", "duration", "rawContent"],
      "properties": {
        "statusCode": { "type": ["integer", "null"] },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "duration": { "type": "string", "minLength": 1 },
        "rawContent": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "modernDiscoveryEvidence": {
      "type": "object",
      "required": ["isValid", "supportedVersions", "capabilityNames", "extensionIds", "resultType", "cacheScope", "ttlMs", "errors"],
      "properties": {
        "isValid": { "type": "boolean" },
        "supportedVersions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "capabilityNames": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "extensionIds": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._/-]+$" }, "uniqueItems": true },
        "extensionAdvertisements": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["extensionId", "isValid", "mimeTypes", "errors"],
            "properties": {
              "extensionId": { "type": "string", "minLength": 1 },
              "isValid": { "type": "boolean" },
              "mimeTypes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "directoryRead": { "type": ["boolean", "null"] },
              "errors": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "resultType": { "type": ["string", "null"] },
        "cacheScope": { "enum": ["public", "private", null] },
        "ttlMs": { "type": ["integer", "null"], "minimum": 0 },
        "instructions": { "type": ["string", "null"] },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "modernDiscoveryTransportResult": {
      "type": "object",
      "required": ["isSuccessful", "error", "payload", "transport"],
      "properties": {
        "isSuccessful": { "type": "boolean" },
        "error": { "type": ["string", "null"] },
        "payload": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/modernDiscoveryEvidence" }] },
        "transport": { "$ref": "#/$defs/transportMetadata" }
      },
      "additionalProperties": true
    },
    "observation": {
      "type": "object",
      "required": ["id", "layerId", "component", "observationKind", "metadata"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "layerId": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "observationKind": { "type": "string", "minLength": 1 },
        "scenarioId": { "type": ["string", "null"] },
        "lane": { "enum": ["baseline", "externalConformance", "extensionReadiness", "clientCompatibility", "modelAdvisory", null] },
        "origin": { "enum": ["deterministicObservation", "deterministicAggregation", "externalConformanceCheck", "heuristicInference", "modelAssistance", null] },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } },
        "redactedPayloadPreview": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": ["layerId", "scope", "status", "blocker", "confidence"],
      "properties": {
        "layerId": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "status": { "type": ["string", "integer"] },
        "lane": { "enum": ["baseline", "externalConformance", "extensionReadiness", "clientCompatibility", "modelAdvisory", null] },
        "origin": { "enum": ["deterministicObservation", "deterministicAggregation", "externalConformanceCheck", "heuristicInference", "modelAssistance", null] },
        "blocker": { "type": ["string", "integer"] },
        "confidence": { "type": ["string", "integer"] },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "appliedPack": {
      "type": "object",
      "required": ["key", "kind", "revision", "displayName", "stability"],
      "properties": {
        "key": { "type": "object", "required": ["value"], "properties": { "value": { "type": "string", "minLength": 1 } } },
        "kind": { "type": ["string", "integer"] },
        "revision": { "type": "object", "required": ["value"], "properties": { "value": { "type": "string", "minLength": 1 } } },
        "displayName": { "type": "string", "minLength": 1 },
        "stability": { "type": ["string", "integer"] },
        "documentationUrl": { "type": ["string", "null"], "format": "uri" },
        "extensionId": { "type": ["string", "null"] },
        "extensionStage": { "enum": ["experimental", "beta", "stable", "core", null] },
        "specificationRevision": { "type": ["string", "null"] },
        "specificationSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "extensionPolicyBehavior": { "enum": ["observationOnly", "preview", "explicitExtensionGate", "core"] }
      },
      "additionalProperties": true
    },
    "officialConformanceAssessment": {
      "type": "object",
      "required": ["verificationStatus", "runner", "requirementSet", "target", "runState", "passed", "creditedPassed", "failed", "warnings", "skipped", "informational", "evidenceSummary", "scenarios", "conflicts", "decisions"],
      "properties": {
        "verificationStatus": { "enum": ["verified", "unverified", "incomplete", "conflict"] },
        "sourceEvidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "runner": { "type": "object", "required": ["packageName", "version", "sourceCommit", "packageSha256"] },
        "requirementSet": { "type": "object", "required": ["revision", "sha256"] },
        "target": { "type": "object", "required": ["identitySha256", "transport", "protocolVersion"] },
        "runState": { "enum": ["completed", "failed", "timedOut", "cancelled"] },
        "passed": { "type": "integer", "minimum": 0 },
        "creditedPassed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "informational": { "type": "integer", "minimum": 0 },
        "evidenceSummary": { "$ref": "#/$defs/evidenceSummary" },
        "scenarios": { "type": "array", "items": { "type": "object" } },
        "conflicts": { "type": "array", "items": { "type": "object" } },
        "decisions": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "extensionAssessment": {
      "type": "object",
      "required": ["extensionId", "stage", "specificationRevision", "specificationSha256", "verdict", "evidenceSummary", "findings"],
      "properties": {
        "extensionId": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["experimental", "beta", "stable", "core"] },
        "specificationRevision": { "type": "string", "minLength": 1 },
        "specificationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "verdict": { "$ref": "#/$defs/verdict" },
        "evidenceSummary": { "$ref": "#/$defs/evidenceSummary" },
        "findings": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
