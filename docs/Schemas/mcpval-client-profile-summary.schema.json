{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/navalerakesh/mcp-validation-security/blob/main/docs/Schemas/mcpval-client-profile-summary.schema.json",
  "title": "MCP Validator Client Profile Summary",
  "type": "object",
  "required": [
    "documentType",
    "documentSchemaVersion",
    "generatedUtc",
    "validationId",
    "validatorVersion",
    "assuranceProfile",
    "certificateEligibility",
    "coreConformance",
    "securityAssurance",
    "operationalReadiness",
    "policyPassed",
    "evidenceSummary",
    "profileCount",
    "compatibleCount",
    "warningCount",
    "incompatibleCount",
    "profiles"
  ],
  "properties": {
    "documentType": { "const": "mcpval.client-profile-summary" },
    "documentSchemaVersion": { "const": "2.0.0" },
    "generatedUtc": { "type": "string", "format": "date-time" },
    "validationId": { "type": "string", "minLength": 1 },
    "validatorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "serverEndpoint": { "type": ["string", "null"] },
    "assuranceProfile": { "enum": ["inventory", "ci", "provider"] },
    "certificateEligibility": { "enum": ["eligible", "ineligible", "reviewRequired"] },
    "coreConformance": { "enum": ["conformant", "nonconformant", "incomplete"] },
    "securityAssurance": { "enum": ["verified", "issuesFound", "incomplete"] },
    "operationalReadiness": { "enum": ["ready", "notReady", "incomplete"] },
    "policyPassed": { "type": "boolean" },
    "policySummary": { "type": ["string", "null"] },
    "evidenceSummary": { "type": "object" },
    "profileCount": { "type": "integer", "minimum": 0 },
    "compatibleCount": { "type": "integer", "minimum": 0 },
    "warningCount": { "type": "integer", "minimum": 0 },
    "incompatibleCount": { "type": "integer", "minimum": 0 },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["profileId", "displayName", "status", "passedRequirements", "warningRequirements", "failedRequirements", "topBlockers"],
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "passedRequirements": { "type": "integer", "minimum": 0 },
          "warningRequirements": { "type": "integer", "minimum": 0 },
          "failedRequirements": { "type": "integer", "minimum": 0 },
          "topBlockers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["requirementId", "title", "ruleIds"],
              "properties": {
                "requirementId": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "ruleIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "recommendation": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
